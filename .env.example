# Template. Each process gets ITS OWN .env (services/bank/.env, services/sq-guardian/.env, services/partner-guardian/.env, apps/wallet/.env.local);
# the root .env holds only the shared + script variables. Guardian processes must never load bank or wallet variables. Never commit real keys.

# ---- Shared (copy into every .env) ----
CHAIN_ID=84532                        # Base Sepolia (primary). Fallback: 11155111 (Ethereum Sepolia) — switch CHAIN_ID, RPC_URL, USDC_ADDRESS, bundler/paymaster URLs and NEXT_PUBLIC_* together
RPC_URL=                              # an RPC that supports eth_simulateV1 if possible (verify in Wave 0)
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e   # Circle USDC on Base Sepolia (Ethereum Sepolia: 0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238)
EURC_ADDRESS=0x808456652fdb597867f38412077A9182bf77359F   # Circle EURC on Base Sepolia (verified 10 Oct 2026, 6 decimals)
RECOVERY_MODULE_ADDRESS=0x949d01d424bE050D09C16025dd007CB59b3A8c66  # Candide SocialRecoveryModule, 3-min grace (testing); same address on Base Sepolia and Ethereum Sepolia. Grace period is read from the contract.
DEMO_FAST_MODE=true                   # persona auto-verdicts; "accelerated for demo" captions

# ---- services/bank/.env (the only process with the paymaster key; holds NO guardian key) ----
BANK_PORT=4000
BANK_CANDIDE_API_KEY=
BANK_CANDIDE_BUNDLER_URL=             # from Candide dashboard, Base Sepolia
BANK_CANDIDE_PAYMASTER_URL=
BANK_VERDICT_PRIVATE_KEY=             # signs identity verdicts only; needs no ETH; generate with viem
BANK_RELAYER_PRIVATE_KEY=             # submits guardian confirmations/finalize when relaying signatures; fund with >= 0.05 Base Sepolia ETH
BANK_FUNDER_PRIVATE_KEY=              # "Top up from Swissquote account": holds USDC + ETH; fund from faucet.circle.com
BANK_JWT_SECRET=
BANK_DB_PATH=./data/bank.sqlite
DESK_OPERATOR_TOKEN=                  # operator login for /desk (SIMULATED SSO)

# ---- services/sq-guardian/.env ----
GUARDIAN_KIND=swissquote
GUARDIAN_PORT=4001
GUARDIAN_PRIVATE_KEY=                 # Swissquote's guardian key; fund with >= 0.05 Base Sepolia ETH
GUARDIAN_DB_PATH=./data/sq-guardian.sqlite
BANK_VERDICT_ADDRESS=                 # address of BANK_VERDICT_PRIVATE_KEY (public)
GUARDIAN_CANDIDE_URL=                 # Candide URL (public endpoint ok) for the guardian-owned sponsored relayer Safe used to submit finalize when the EOA holds no ETH

# ---- services/partner-guardian/.env (assisted mode only) ----
GUARDIAN_KIND=partner
GUARDIAN_PORT=4002
GUARDIAN_PRIVATE_KEY=                 # fund with >= 0.05 Base Sepolia ETH
GUARDIAN_DB_PATH=./data/partner-guardian.sqlite
BANK_VERDICT_ADDRESS=

# ---- apps/wallet/.env.local (public values only) ----
NEXT_PUBLIC_BANK_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_EXPLORER=https://sepolia.basescan.org
NEXT_PUBLIC_REOWN_PROJECT_ID=           # Reown Cloud project id (WalletKit, free at cloud.reown.com); wallet side of WalletConnect
WALLET_RP_ID=localhost                # passkeys are bound to this; never change after first registration
WALLET_ORIGIN=http://localhost:3000
